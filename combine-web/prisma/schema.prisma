generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Product {
  id                Int               @id @default(autoincrement())
  sku               String?           @unique
  brand             String
  category          String
  subCategory       String?
  name              String
  model             String?
  shortDescription  String?
  description       String
  costPriceCny      Float?
  priceRemark       String?
  price             Float
  mainColor         String?
  dimensions        String?
  availability      Availability      @default(PRE_ORDER)
  featured          Boolean           @default(false)
  newArrival        Boolean           @default(false)
  bestSeller        Boolean           @default(false)
  limited           Boolean           @default(false)
  onSale            Boolean           @default(false)
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt
  slug              String?           @unique
  displayOrder      Int               @default(9999)
  customPackagingId Int?
  categoryId        Int?
  subCategoryId     Int?
  inquiryItems      InquiryItem[]
  orderItems        OrderItem[]
  categoryRecord    Category?         @relation("ProductCategory", fields: [categoryId], references: [id])
  customPackaging   PackagingProfile? @relation("ProductCustomPackaging", fields: [customPackagingId], references: [id])
  subCategoryRecord SubCategory?      @relation("ProductSubCategory", fields: [subCategoryId], references: [id])
  colors            ProductColor[]
  images            ProductImage[]
  variants          ProductVariant[]
  wishlistItems     WishlistItem[]

  @@index([brand])
  @@index([category])
  @@index([subCategory])
  @@index([categoryId])
  @@index([subCategoryId])
  @@index([availability])
  @@index([name])
  @@index([displayOrder])
  @@index([customPackagingId])
}

model ProductImage {
  id        Int       @id @default(autoincrement())
  productId Int
  url       String
  publicId  String
  sortOrder Int       @default(1)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  altText   String?
  caption   String?
  type      ImageType @default(GALLERY)
  product   Product   @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId])
  @@index([type])
  @@index([sortOrder])
}

model Color {
  id            Int              @id @default(autoincrement())
  name          String           @unique
  slug          String           @unique
  hexCode       String?
  active        Boolean          @default(true)
  sortOrder     Int              @default(9999)
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt
  productColors ProductColor[]
  variants      ProductVariant[]

  @@index([active])
  @@index([sortOrder])
}

model ProductColor {
  id        Int                 @id @default(autoincrement())
  productId Int
  name      String
  imageUrl  String
  publicId  String?
  sortOrder Int                 @default(0)
  createdAt DateTime            @default(now())
  updatedAt DateTime            @updatedAt
  model     String?
  colorId   Int?
  color     Color?              @relation(fields: [colorId], references: [id])
  product   Product             @relation(fields: [productId], references: [id], onDelete: Cascade)
  images    ProductColorImage[]

  @@index([productId])
  @@index([colorId])
  @@index([sortOrder])
}

model ProductColorImage {
  id        Int          @id @default(autoincrement())
  colorId   Int
  url       String
  publicId  String
  altText   String?
  caption   String?
  sortOrder Int          @default(1)
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt
  color     ProductColor @relation(fields: [colorId], references: [id], onDelete: Cascade)

  @@index([colorId])
}

model ProductVariant {
  id                Int                   @id @default(autoincrement())
  productId         Int
  size              String
  model             String?
  dimensions        String?
  sortOrder         Int                   @default(1)
  createdAt         DateTime              @default(now())
  updatedAt         DateTime              @updatedAt
  imageUrl          String?
  publicId          String?
  colorId           Int?
  price             Float?
  costPriceCny      Float?
  exchangeRate      Float?
  productOrderItems OrderItem[]
  color             Color?                @relation(fields: [colorId], references: [id])
  product           Product               @relation(fields: [productId], references: [id], onDelete: Cascade)
  images            ProductVariantImage[]

  @@unique([productId, size, colorId])
  @@index([productId])
  @@index([colorId])
  @@index([sortOrder])
}

model ProductVariantImage {
  id        Int            @id @default(autoincrement())
  variantId Int
  url       String
  publicId  String
  altText   String?
  caption   String?
  sortOrder Int            @default(1)
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt
  variant   ProductVariant @relation(fields: [variantId], references: [id], onDelete: Cascade)

  @@index([variantId])
}

model Category {
  id            Int           @id @default(autoincrement())
  name          String        @unique
  slug          String        @unique
  active        Boolean       @default(true)
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
  products      Product[]     @relation("ProductCategory")
  subCategories SubCategory[]

  @@index([active])
}

model SubCategory {
  id         Int       @id @default(autoincrement())
  name       String
  slug       String    @unique
  categoryId Int?
  active     Boolean   @default(true)
  sortOrder  Int       @default(9999)
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
  products   Product[] @relation("ProductSubCategory")
  category   Category? @relation(fields: [categoryId], references: [id])

  @@index([name])
  @@index([categoryId])
  @@index([active])
  @@index([sortOrder])
}

model Brand {
  id                Int                @id @default(autoincrement())
  name              String             @unique
  slug              String             @unique
  active            Boolean            @default(true)
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt
  packagingProfiles PackagingProfile[]

  @@index([active])
}

model PackagingProfile {
  id             Int              @id @default(autoincrement())
  key            String           @unique
  name           String
  brand          String?
  title          String?
  description    String?
  active         Boolean          @default(true)
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt
  images         PackagingImage[]
  items          PackagingItem[]
  brandRecord    Brand?           @relation(fields: [brand], references: [name])
  customProducts Product[]        @relation("ProductCustomPackaging")

  @@index([brand])
  @@index([active])
}

model PackagingImage {
  id          Int              @id @default(autoincrement())
  packagingId Int
  url         String
  publicId    String
  altText     String?
  caption     String?
  sortOrder   Int              @default(1)
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
  packaging   PackagingProfile @relation(fields: [packagingId], references: [id], onDelete: Cascade)

  @@index([packagingId])
  @@index([sortOrder])
}

model PackagingItem {
  id          Int              @id @default(autoincrement())
  packagingId Int
  name        String
  sortOrder   Int              @default(1)
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
  packaging   PackagingProfile @relation(fields: [packagingId], references: [id], onDelete: Cascade)

  @@index([packagingId])
}

model User {
  id                  Int                  @id @default(autoincrement())
  name                String
  email               String               @unique
  password            String
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt
  role                UserRole
  active              Boolean              @default(true)
  image               String?
  phone               String?
  dateOfBirth         DateTime?
  inquiries           Inquiry[]
  orders              Order[]
  passwordResetTokens PasswordResetToken[]
  sessions            Session[]
  voucherUsages       VoucherUsage[]
  wishlistItems       WishlistItem[]
}

model PasswordResetToken {
  id        Int      @id @default(autoincrement())
  token     String   @unique
  userId    Int
  expiresAt DateTime
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([token])
  @@index([expiresAt])
}

model Session {
  id        String   @id @default(cuid())
  token     String   @unique
  userId    Int
  expiresAt DateTime
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([token])
  @@index([expiresAt])
}

model WishlistItem {
  id        Int      @id @default(autoincrement())
  userId    Int
  productId Int
  createdAt DateTime @default(now())
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, productId])
}

model InquiryItem {
  id         Int      @id @default(autoincrement())
  productId  Int
  quantity   Int      @default(1)
  notes      String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  inquiryId  Int
  color      String?
  dimensions String?
  packaging  String?
  variant    String?
  inquiry    Inquiry  @relation(fields: [inquiryId], references: [id], onDelete: Cascade)
  product    Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([inquiryId])
  @@index([productId])
}

model Inquiry {
  id        Int           @id @default(autoincrement())
  name      String
  whatsapp  String
  email     String?
  country   String?
  message   String?
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt
  status    InquiryStatus @default(PENDING)
  userId    Int?
  user      User?         @relation(fields: [userId], references: [id])
  items     InquiryItem[]

  @@index([status])
  @@index([createdAt])
  @@index([userId])
}

model PaymentMethod {
  id            Int               @id @default(autoincrement())
  name          String
  type          PaymentMethodType
  bankName      String?
  accountName   String?
  accountNumber String?
  qrImageUrl    String?
  qrPublicId    String?
  instructions  String?
  active        Boolean           @default(true)
  sortOrder     Int               @default(9999)
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt
  wiseAccount   String?
  wiseEmail     String?
  wiseName      String?
  payments      Payment[]

  @@index([type])
  @@index([active])
  @@index([sortOrder])
}

model Order {
  id                    Int                  @id @default(autoincrement())
  customerName          String
  customerPhone         String
  customerEmail         String?
  address               String?
  subtotal              Float
  voucherCode           String?
  voucherDiscount       Float                @default(0)
  finalAmount           Float
  status                OrderStatus          @default(PENDING_PAYMENT)
  createdAt              DateTime             @default(now())
  updatedAt              DateTime             @updatedAt

  /// *
  ///    * Random public token used for customer-facing
  ///    * order/payment pages.
  ///    * Customers must use this token instead of
  ///    * exposing the numeric Order ID directly.
  /// *
  publicToken            String               @unique @default(cuid())

  shippingCourier        String?
  trackingNumber         String?
  trackingUrl            String?
  message                String?

  /// *
  ///    * Customer Account relation.
  ///    * Optional so existing orders created before
  ///    * Customer Account linking continue to work.
  /// *
  userId                 Int?

  /// *
  ///    * Shipping fee snapshot.
  ///    *
  ///    * For Malaysia orders this stores the normal
  ///    * ABX shipping fee.
  ///    *
  ///    * For international orders this remains 0
  ///    * until the shipping fee is confirmed.
  /// *
  shippingFee            Float                @default(0)

  /// *
  ///    * Malaysia shipping region.
  ///    *
  ///    * WEST / EAST for the existing Malaysia
  ///    * ABX shipping calculation.
  ///    *
  ///    * International orders use null.
  /// *
  shippingRegion         String?

  /// *
  ///    * Customer shipping country.
  ///    *
  ///    * Example:
  ///    * Malaysia
  ///    * Singapore
  ///    * United Arab Emirates
  /// *
  shippingCountry        String?

  /// *
  ///    * Shipping type.
  ///    *
  ///    * LOCAL:
  ///    * Existing Malaysia shipping rules.
  ///    *
  ///    * INTERNATIONAL:
  ///    * Shipping fee must be confirmed manually.
  /// *
  shippingType           ShippingType         @default(LOCAL)

  /// *
  ///    * International shipping quotation status.
  ///    *
  ///    * NOT_REQUIRED:
  ///    * Malaysia/local order.
  ///    *
  ///    * PENDING:
  ///    * Customer has requested shipping fee.
  ///    *
  ///    * QUOTED:
  ///    * Admin has confirmed the international
  ///    * shipping fee and customer can continue
  ///    * with payment.
  /// *
  shippingQuoteStatus    ShippingQuoteStatus  @default(NOT_REQUIRED)

  /// *
  ///    * Customer-facing Order Reference.
  ///    * Example:
  ///    * CL-20260901-0050
  ///    *
  ///    * Nullable temporarily so existing orders can remain
  ///    * in the database while their Order Reference is backfilled.
  /// *
  orderNumber            String?              @unique

  /// *
  ///    * PayPal processing fee snapshot.
  /// *
  paypalFee              Float                @default(0)

  user                   User?                @relation(fields: [userId], references: [id])
  items                  OrderItem[]
  payment                Payment?
  voucherUsage           VoucherUsage?

  @@index([status])
  @@index([customerPhone])
  @@index([createdAt])
  @@index([publicToken])
  @@index([userId])
  @@index([voucherCode])
  @@index([shippingCountry])
  @@index([shippingType])
  @@index([shippingQuoteStatus])
}

model OrderItem {
  id             Int             @id @default(autoincrement())
  orderId        Int
  productId      Int
  brand          String
  productName    String
  sku            String?
  color          String?
  variant        String?
  dimensions     String?
  packaging      String?
  quantity       Int             @default(1)
  unitPrice      Float
  totalPrice     Float
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  /// *
  ///    * Exact ProductVariant ID.
  ///    * Nullable so products without Variants
  ///    * remain supported.
  variantId      Int?
  profit         Float?
  totalCost      Float?
  /// *
  ///    * Cost / Profit Snapshot
  ///    * These values are stored permanently on the
  ///    * OrderItem so historical orders remain accurate
  ///    * even if the Product / ProductVariant cost price
  ///    * or exchange rate changes later.
  ///    * unitCost:
  ///    * Cost of one unit in MYR.
  ///    * totalCost:
  ///    * unitCost × quantity.
  ///    * profit:
  ///    * totalPrice - totalCost.
  ///    * Nullable for legacy orders or products where
  ///    * a valid cost price cannot be determined.
  unitCost       Float?
  order          Order           @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product        Product         @relation(fields: [productId], references: [id])
  productVariant ProductVariant? @relation(fields: [variantId], references: [id])

  @@index([orderId])
  @@index([productId])
  @@index([variantId])
}

model Payment {
  id                Int               @id @default(autoincrement())
  orderId           Int               @unique
  paymentMethodId   Int?
  paymentMethodName String
  paymentMethodType PaymentMethodType
  bankName          String?
  accountName       String?
  accountNumber     String?
  qrImageUrl        String?
  qrPublicId        String?
  amount            Float
  status            PaymentStatus     @default(PENDING)
  proofUrl          String?
  proofPublicId     String?
  verifiedAt        DateTime?
  verifiedBy        Int?
  adminNote         String?
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt
  wiseAccount       String?
  wiseEmail         String?
  wiseName          String?
  order             Order             @relation(fields: [orderId], references: [id], onDelete: Cascade)
  paymentMethod     PaymentMethod?    @relation(fields: [paymentMethodId], references: [id])

  @@index([paymentMethodId])
  @@index([status])
  @@index([createdAt])
}

model Voucher {
  id               Int            @id @default(autoincrement())
  /// *
  ///    * Voucher code shown to customers.
  ///    * Stored uppercase so validation remains consistent.
  code             String         @unique
  /// *
  ///    * FIXED:
  ///    * RM100 OFF
  ///    * PERCENTAGE:
  ///    * 10% OFF
  type             VoucherType
  /// *
  ///    * Discount value.
  ///    * FIXED:
  ///    * 100 = RM100
  ///    * PERCENTAGE:
  ///    * 10 = 10%
  value            Float
  /// *
  ///    * Minimum product subtotal required
  ///    * before the voucher can be used.
  minSpend         Float          @default(0)
  /// *
  ///    * Maximum discount allowed.
  ///    * Mainly useful for percentage vouchers.
  ///    * Example:
  ///    * 10% OFF
  ///    * Maximum RM300
  maxDiscount      Float?
  /// *
  ///    * Optional category restriction.
  ///    * NULL:
  ///    * All categories
  ///    * "Bags":
  ///    * Bags only
  ///    * "Watches":
  ///    * Watches only
  category         String?
  /// *
  ///    * Voucher validity period.
  startAt          DateTime       @default(now())
  expiresAt        DateTime?
  /// *
  ///    * Total number of times this voucher
  ///    * can be redeemed.
  ///    * NULL = unlimited.
  usageLimit       Int?
  /// *
  ///    * Number of successful redemptions.
  usageCount       Int            @default(0)
  /// *
  ///    * Maximum number of times one customer
  ///    * can use this voucher.
  ///    * NULL = unlimited.
  usagePerCustomer Int?
  /// *
  ///    * Only customers who have never
  ///    * successfully placed an order
  ///    * can use this voucher.
  newCustomerOnly  Boolean        @default(false)
  /// *
  ///    * Admin can activate/deactivate
  ///    * the voucher without deleting it.
  isActive         Boolean        @default(true)
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt
  usage            VoucherUsage[]

  @@index([code])
  @@index([isActive])
  @@index([startAt])
  @@index([expiresAt])
  @@index([category])
}

model VoucherUsage {
  id        Int      @id @default(autoincrement())
  voucherId Int
  orderId   Int      @unique
  /// *
  ///    * Nullable because orders can exist
  ///    * without a logged-in Customer Account.
  userId    Int?
  /// *
  ///    * Actual discount granted by this
  ///    * particular Voucher usage.
  ///    * This is stored permanently so changing
  ///    * the Voucher later does not alter
  ///    * historical order records.
  discount  Float
  createdAt DateTime @default(now())
  order     Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  user      User?    @relation(fields: [userId], references: [id])
  voucher   Voucher  @relation(fields: [voucherId], references: [id])

  @@index([voucherId])
  @@index([userId])
  @@index([createdAt])
}

model Setting {
  id                 Int      @id @default(autoincrement())
  companyName        String   @default("COMBINE")
  whatsappNumber     String   @default("60166620448")
  exchangeRate       Float    @default(0.59)
  email              String?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
  address            String?
  companyDescription String?
  companyLogo        String?
  facebook           String?
  instagram          String?
  maintenanceMode    Boolean  @default(false)
  metaDescription    String?
  phone              String?
  siteTitle          String?
  tiktok             String?
  website            String?
  youtube            String?
  paypalFeeFixed     Float    @default(2.00)
  paypalFeeRate      Float    @default(6.0)
}

model AnalyticsVisitor {
  id          Int      @id @default(autoincrement())
  visitorId   String   @unique
  firstSeenAt DateTime @default(now())
  lastSeenAt  DateTime @updatedAt

  @@index([firstSeenAt])
  @@index([lastSeenAt])
}

model AnalyticsEvent {
  id        Int                @id @default(autoincrement())
  visitorId String
  event     AnalyticsEventType
  path      String?
  productId Int?
  createdAt DateTime           @default(now())

  @@index([visitorId])
  @@index([event])
  @@index([createdAt])
  @@index([productId])
}

enum PaymentMethodType {
  BANK_TRANSFER
  QR
  PAYPAL
  WISE
}

enum OrderStatus {
  PENDING_PAYMENT
  PAYMENT_REVIEW
  PAID
  PROCESSING
  SHIPPED
  COMPLETED
  CANCELLED
}

enum ShippingType {
  LOCAL
  INTERNATIONAL
}

enum ShippingQuoteStatus {
  NOT_REQUIRED
  PENDING
  QUOTED
}

enum PaymentStatus {
  PENDING
  SUBMITTED
  VERIFIED
  REJECTED
}

enum Availability {
  IN_STOCK
  PRE_ORDER
  LIMITED
  SOLD_OUT
}

enum ImageType {
  MAIN
  GALLERY
  DETAIL
  PACKAGING
}

enum UserRole {
  CUSTOMER
  ADMIN
  STAFF
  MANAGER
  OWNER
}

enum InquiryStatus {
  PENDING
  CONTACTED
  COMPLETED
  CANCELLED
}

enum VoucherType {
  FIXED
  PERCENTAGE
}

enum AnalyticsEventType {
  PAGE_VIEW
  PRODUCT_VIEW
  WHATSAPP_CLICK
  INSTAGRAM_CLICK
}
