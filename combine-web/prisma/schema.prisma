generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Product {
  id          Int     @id @default(autoincrement())
  sku         String? @unique
  brand       String
  category    String
  subCategory String?
  name        String
  slug        String? @unique

  model            String?
  shortDescription String?
  description      String

  costPriceCny Float?
  priceRemark  String?
  price        Float

  mainColor  String?
  dimensions String?

  availability Availability @default(PRE_ORDER)

  featured   Boolean @default(false)
  newArrival Boolean @default(false)
  bestSeller Boolean @default(false)
  limited    Boolean @default(false)
  onSale     Boolean @default(false)

  displayOrder Int @default(9999)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  inquiryItems  InquiryItem[]
  colors        ProductColor[]
  images        ProductImage[]
  variants      ProductVariant[]
  wishlistItems WishlistItem[]

  // Product-specific packaging override.
  // If null, use Brand Packaging,
  // then Default Packaging.
  customPackagingId Int?
  customPackaging   PackagingProfile? @relation("ProductCustomPackaging", fields: [customPackagingId], references: [id], onDelete: SetNull)

  @@index([brand])
  @@index([category])
  @@index([subCategory])
  @@index([availability])
  @@index([name])
  @@index([displayOrder])
  @@index([customPackagingId])
}

model ProductImage {
  id        Int @id @default(autoincrement())
  productId Int

  url      String
  publicId String

  type ImageType @default(GALLERY)

  altText   String?
  caption   String?
  sortOrder Int     @default(1)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId])
  @@index([type])
  @@index([sortOrder])
}

// ============================================================
// GLOBAL COLOR MASTER
// ============================================================

model Color {
  id        Int     @id @default(autoincrement())
  name      String  @unique
  slug      String  @unique
  hexCode   String?
  active    Boolean @default(true)
  sortOrder Int     @default(9999)

  productColors ProductColor[]
  variants      ProductVariant[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([active])
  @@index([sortOrder])
}

// ============================================================
// PRODUCT COLOR
// ============================================================

model ProductColor {
  id    Int     @id @default(autoincrement())
  name  String
  model String?

  // Global Color relation.
  colorId Int?
  color   Color? @relation(fields: [colorId], references: [id], onDelete: SetNull)

  // Legacy single color image.
  // Keep these fields for existing products.
  imageUrl String
  publicId String?

  sortOrder Int @default(0)

  productId Int
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  // One color can have multiple gallery images.
  images ProductColorImage[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([productId])
  @@index([colorId])
  @@index([sortOrder])
}

model ProductColorImage {
  id      Int @id @default(autoincrement())
  colorId Int

  url      String
  publicId String

  altText   String?
  caption   String?
  sortOrder Int     @default(1)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  color ProductColor @relation(fields: [colorId], references: [id], onDelete: Cascade)

  @@index([colorId])
  @@index([sortOrder])
}

// ============================================================
// PRODUCT VARIANT
// ============================================================

model ProductVariant {
  id        Int @id @default(autoincrement())
  productId Int

  size       String
  model      String?
  dimensions String?

  // Global Color relation.
  //
  // Example:
  // Black -> colorId: 1
  // Grey  -> colorId: 2
  colorId Int?
  color   Color? @relation(fields: [colorId], references: [id], onDelete: SetNull)

  // Legacy single Variant image.
  // Keep these fields for existing products.
  imageUrl String?
  publicId String?

  // New Variant gallery.
  // One Variant can contain multiple images.
  images ProductVariantImage[]

  sortOrder Int @default(1)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  // Same Product can have the same Size
  // in different Colors.
  //
  // Example:
  // Black / M
  // White / M
  //
  // Both are valid.
  @@unique([productId, size, colorId])
  @@index([productId])
  @@index([colorId])
  @@index([sortOrder])
}

// ============================================================
// PRODUCT VARIANT IMAGE
// ============================================================

model ProductVariantImage {
  id        Int @id @default(autoincrement())
  variantId Int

  url      String
  publicId String

  altText String?
  caption String?

  sortOrder Int @default(1)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  variant ProductVariant @relation(fields: [variantId], references: [id], onDelete: Cascade)

  @@index([variantId])
  @@index([sortOrder])
}

// ============================================================
// CATEGORY
// ============================================================

model Category {
  id        Int      @id @default(autoincrement())
  name      String   @unique
  slug      String   @unique
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Sub Categories belonging to this Category.
  subCategories SubCategory[]

  @@index([active])
}

model SubCategory {
  id Int @id @default(autoincrement())

  name String
  slug String @unique

  // Optional parent Category.
  categoryId Int?
  category   Category? @relation(fields: [categoryId], references: [id], onDelete: SetNull)

  active    Boolean @default(true)
  sortOrder Int     @default(9999)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([name])
  @@index([categoryId])
  @@index([active])
  @@index([sortOrder])
}

// ============================================================
// BRAND
// ============================================================

model Brand {
  id        Int      @id @default(autoincrement())
  name      String   @unique
  slug      String   @unique
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  packagingProfiles PackagingProfile[]

  @@index([active])
}

// ============================================================
// PACKAGING
// ============================================================

model PackagingProfile {
  id Int @id @default(autoincrement())

  /**
   * Examples:
   * __DEFAULT__
   * brand:Louis Vuitton
   * brand:Gucci
   * brand:Dior
   */

  key String @unique

  /**
   * Display name.
   * Default Packaging
   * Louis Vuitton
   * Gucci
   * Dior
   */

  name String

  /**
   * Null = Default Packaging.
   * Otherwise matches Product.brand.
   */

  brand String?

  title       String?
  description String?

  active Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  images PackagingImage[]
  items  PackagingItem[]

  // Products using this packaging as a custom override.
  customProducts Product[] @relation("ProductCustomPackaging")

  // Connects packaging to the existing Brand.name.
  brandRecord Brand? @relation(fields: [brand], references: [name], onDelete: SetNull)

  @@index([brand])
  @@index([active])
}

model PackagingImage {
  id Int @id @default(autoincrement())

  packagingId Int

  url      String
  publicId String

  altText String?
  caption String?

  sortOrder Int @default(1)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  packaging PackagingProfile @relation(fields: [packagingId], references: [id], onDelete: Cascade)

  @@index([packagingId])
  @@index([sortOrder])
}

model PackagingItem {
  id Int @id @default(autoincrement())

  packagingId Int

  name String

  sortOrder Int @default(1)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  packaging PackagingProfile @relation(fields: [packagingId], references: [id], onDelete: Cascade)

  @@index([packagingId])
  @@index([sortOrder])
}

// ============================================================
// USER
// ============================================================

model User {
  id       Int    @id @default(autoincrement())
  name     String
  email    String @unique
  password String

  image String?

  active Boolean @default(true)

  role UserRole

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  sessions      Session[]
  wishlistItems WishlistItem[]
}

model Session {
  id        String   @id @default(cuid())
  token     String   @unique
  userId    Int
  expiresAt DateTime

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([token])
  @@index([expiresAt])
}

// ============================================================
// WISHLIST
// ============================================================

model WishlistItem {
  id        Int @id @default(autoincrement())
  userId    Int
  productId Int

  createdAt DateTime @default(now())

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, productId])
}

// ============================================================
// INQUIRY
// ============================================================

model InquiryItem {
  id Int @id @default(autoincrement())

  inquiryId Int
  productId Int

  quantity Int @default(1)

  color      String?
  variant    String?
  dimensions String?
  packaging  String?

  notes String?

  inquiry Inquiry @relation(fields: [inquiryId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([inquiryId])
  @@index([productId])
}

model Inquiry {
  id Int @id @default(autoincrement())

  name     String
  whatsapp String

  email   String?
  country String?
  message String?

  status InquiryStatus @default(PENDING)

  items InquiryItem[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status])
  @@index([createdAt])
}

// ============================================================
// SETTINGS
// ============================================================

model Setting {
  id Int @id @default(autoincrement())

  // Company
  companyName        String  @default("COMBINE")
  companyLogo        String?
  companyDescription String?

  // Contact
  whatsappNumber String  @default("60166620448")
  phone          String?
  email          String?
  address        String?
  website        String?

  // Social
  facebook  String?
  instagram String?
  tiktok    String?
  youtube   String?

  // Business
  exchangeRate Float @default(0.59)

  // SEO
  siteTitle       String?
  metaDescription String?

  // System
  maintenanceMode Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ============================================================
// ENUMS
// ============================================================

enum Availability {
  IN_STOCK
  PRE_ORDER
  LIMITED
  SOLD_OUT
}

enum ImageType {
  MAIN
  GALLERY
  DETAIL
  PACKAGING
}

enum UserRole {
  CUSTOMER
  ADMIN
  STAFF
  MANAGER
  OWNER
}

enum InquiryStatus {
  PENDING
  CONTACTED
  COMPLETED
  CANCELLED
}
