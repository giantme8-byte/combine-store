generator client {
  provider = "prisma-client-js"
}


datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}


// ============================================================
// PRODUCT
// ============================================================

model Product {
  id                Int          @id @default(autoincrement())
  sku               String?      @unique
  brand             String
  category          String
  subCategory       String?
  name              String
  model             String?
  shortDescription  String?
  description       String
  costPriceCny      Float?
  priceRemark       String?
  price             Float
  mainColor         String?
  dimensions        String?
  availability      Availability @default(PRE_ORDER)
  featured          Boolean      @default(false)
  newArrival        Boolean      @default(false)
  bestSeller        Boolean      @default(false)
  limited           Boolean      @default(false)
  onSale            Boolean      @default(false)
  createdAt         DateTime     @default(now())
  updatedAt         DateTime     @updatedAt
  slug              String?      @unique
  displayOrder      Int          @default(9999)
  customPackagingId Int?
  categoryId        Int?
  subCategoryId     Int?

  inquiryItems InquiryItem[]
  orderItems   OrderItem[]

  categoryRecord    Category?         @relation("ProductCategory", fields: [categoryId], references: [id])
  customPackaging   PackagingProfile? @relation("ProductCustomPackaging", fields: [customPackagingId], references: [id])
  subCategoryRecord SubCategory?      @relation("ProductSubCategory", fields: [subCategoryId], references: [id])

  colors        ProductColor[]
  images        ProductImage[]
  variants      ProductVariant[]
  wishlistItems WishlistItem[]

  @@index([brand])
  @@index([category])
  @@index([subCategory])
  @@index([categoryId])
  @@index([subCategoryId])
  @@index([availability])
  @@index([name])
  @@index([displayOrder])
  @@index([customPackagingId])
}


// ============================================================
// PRODUCT IMAGE
// ============================================================

model ProductImage {
  id        Int       @id @default(autoincrement())
  productId Int
  url       String
  publicId  String
  sortOrder Int      @default(1)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  altText   String?
  caption   String?
  type      ImageType @default(GALLERY)

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId])
  @@index([type])
  @@index([sortOrder])
}


// ============================================================
// COLOR
// ============================================================

model Color {
  id        Int      @id @default(autoincrement())
  name      String   @unique
  slug      String   @unique
  hexCode   String?
  active    Boolean  @default(true)
  sortOrder Int      @default(9999)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  productColors ProductColor[]
  variants      ProductVariant[]

  @@index([active])
  @@index([sortOrder])
}


// ============================================================
// PRODUCT COLOR
// ============================================================

model ProductColor {
  id        Int      @id @default(autoincrement())
  productId Int
  name      String
  imageUrl  String
  publicId  String?
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  model     String?
  colorId   Int?

  color   Color?              @relation(fields: [colorId], references: [id])
  product Product             @relation(fields: [productId], references: [id], onDelete: Cascade)
  images  ProductColorImage[]

  @@index([productId])
  @@index([colorId])
  @@index([sortOrder])
}


// ============================================================
// PRODUCT COLOR IMAGE
// ============================================================

model ProductColorImage {
  id        Int      @id @default(autoincrement())
  colorId   Int
  url       String
  publicId  String
  altText   String?
  caption   String?
  sortOrder Int      @default(1)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  color ProductColor @relation(fields: [colorId], references: [id], onDelete: Cascade)

  @@index([colorId])
}


// ============================================================
// PRODUCT VARIANT
// ============================================================

model ProductVariant {
  id           Int      @id @default(autoincrement())
  productId    Int
  size         String
  model        String?
  dimensions   String?
  sortOrder    Int      @default(1)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  imageUrl     String?
  publicId     String?
  colorId      Int?
  price        Float?
  costPriceCny Float?
  exchangeRate Float?

  color   Color?  @relation(fields: [colorId], references: [id])
  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  images  ProductVariantImage[]

  /*
   * IMPORTANT:
   *
   * This relation is named productOrderItems
   * because OrderItem already has:
   *
   * variant String?
   */

  productOrderItems OrderItem[]

  @@unique([productId, size, colorId])
  @@index([productId])
  @@index([colorId])
  @@index([sortOrder])
}


// ============================================================
// PRODUCT VARIANT IMAGE
// ============================================================

model ProductVariantImage {
  id        Int      @id @default(autoincrement())
  variantId Int
  url       String
  publicId  String
  altText   String?
  caption   String?
  sortOrder Int      @default(1)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  variant ProductVariant @relation(fields: [variantId], references: [id], onDelete: Cascade)

  @@index([variantId])
}


// ============================================================
// CATEGORY
// ============================================================

model Category {
  id        Int      @id @default(autoincrement())
  name      String   @unique
  slug      String   @unique
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  products      Product[]     @relation("ProductCategory")
  subCategories SubCategory[]

  @@index([active])
}


// ============================================================
// SUB CATEGORY
// ============================================================

model SubCategory {
  id         Int      @id @default(autoincrement())
  name       String
  slug       String   @unique
  categoryId Int?
  active     Boolean  @default(true)
  sortOrder  Int      @default(9999)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  products Product[] @relation("ProductSubCategory")
  category Category? @relation(fields: [categoryId], references: [id])

  @@index([name])
  @@index([categoryId])
  @@index([active])
  @@index([sortOrder])
}


// ============================================================
// BRAND
// ============================================================

model Brand {
  id        Int      @id @default(autoincrement())
  name      String   @unique
  slug      String   @unique
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  packagingProfiles PackagingProfile[]

  @@index([active])
}


// ============================================================
// PACKAGING PROFILE
// ============================================================

model PackagingProfile {
  id          Int      @id @default(autoincrement())
  key         String   @unique
  name        String
  brand       String?
  title       String?
  description String?
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  images PackagingImage[]
  items  PackagingItem[]

  brandRecord    Brand?    @relation(fields: [brand], references: [name])
  customProducts Product[] @relation("ProductCustomPackaging")

  @@index([brand])
  @@index([active])
}


// ============================================================
// PACKAGING IMAGE
// ============================================================

model PackagingImage {
  id          Int      @id @default(autoincrement())
  packagingId Int
  url         String
  publicId    String
  altText     String?
  caption     String?
  sortOrder   Int      @default(1)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  packaging PackagingProfile @relation(fields: [packagingId], references: [id], onDelete: Cascade)

  @@index([packagingId])
  @@index([sortOrder])
}


// ============================================================
// PACKAGING ITEM
// ============================================================

model PackagingItem {
  id         Int      @id @default(autoincrement())
  packagingId Int
  name       String
  sortOrder  Int      @default(1)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  packaging PackagingProfile @relation(fields: [packagingId], references: [id], onDelete: Cascade)

  @@index([packagingId])
}


// ============================================================
// USER
// ============================================================

model User {
  id           Int      @id @default(autoincrement())
  name         String
  email        String   @unique
  password     String
  phone        String?
  dateOfBirth  DateTime?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  role         UserRole
  active       Boolean  @default(true)
  image        String?

  sessions             Session[]
  passwordResetTokens  PasswordResetToken[]
  wishlistItems        WishlistItem[]
  orders               Order[]
  inquiries            Inquiry[]
  voucherUsages        VoucherUsage[]
}


// ============================================================
// PASSWORD RESET TOKEN
// ============================================================

model PasswordResetToken {
  id        Int      @id @default(autoincrement())
  token     String   @unique
  userId    Int
  expiresAt DateTime
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([token])
  @@index([expiresAt])
}


// ============================================================
// SESSION
// ============================================================

model Session {
  id        String   @id @default(cuid())
  token     String   @unique
  userId    Int
  expiresAt DateTime
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([token])
  @@index([expiresAt])
}


// ============================================================
// WISHLIST
// ============================================================

model WishlistItem {
  id        Int      @id @default(autoincrement())
  userId    Int
  productId Int
  createdAt DateTime @default(now())

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, productId])
}


// ============================================================
// INQUIRY ITEM
// ============================================================

model InquiryItem {
  id         Int      @id @default(autoincrement())
  productId  Int
  quantity   Int      @default(1)
  notes      String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  inquiryId  Int
  color      String?
  dimensions String?
  packaging  String?
  variant    String?

  inquiry Inquiry @relation(fields: [inquiryId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([inquiryId])
  @@index([productId])
}


// ============================================================
// INQUIRY
// ============================================================

model Inquiry {
  id        Int           @id @default(autoincrement())
  name      String
  whatsapp  String
  email     String?
  country   String?
  message   String?
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt
  status    InquiryStatus @default(PENDING)

  userId Int?
  user   User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  items InquiryItem[]

  @@index([status])
  @@index([createdAt])
  @@index([userId])
}


// ============================================================
// PAYMENT METHOD
// ============================================================

model PaymentMethod {
  id            Int               @id @default(autoincrement())
  name          String
  type          PaymentMethodType
  bankName      String?
  accountName   String?
  accountNumber String?
  qrImageUrl    String?
  qrPublicId    String?
  instructions  String?
  active        Boolean           @default(true)
  sortOrder     Int               @default(9999)
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt

  payments Payment[]

  @@index([type])
  @@index([active])
  @@index([sortOrder])
}


// ============================================================
// ORDER
// ============================================================

model Order {
  id            Int     @id @default(autoincrement())
  customerName  String
  customerPhone String
  customerEmail String?
  address       String?
  message       String?

  subtotal Float

  voucherCode     String?
  voucherDiscount Float   @default(0)

  shippingFee    Float   @default(0)
  shippingRegion String?

  finalAmount Float

  status OrderStatus @default(PENDING_PAYMENT)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  /*
   * Random public token used for customer-facing
   * order/payment pages.
   * Customers must use this token instead of
   * exposing the numeric Order ID directly.
   */

  publicToken String @unique @default(cuid())

  shippingCourier String?
  trackingNumber  String?
  trackingUrl     String?

  /*
   * Customer Account relation.
   * Optional so existing orders created before
   * Customer Account linking continue to work.
   */

  userId Int?
  user   User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  items   OrderItem[]
  payment Payment?

  voucherUsage VoucherUsage?

  @@index([status])
  @@index([customerPhone])
  @@index([createdAt])
  @@index([publicToken])
  @@index([userId])
  @@index([voucherCode])
}


// ============================================================
// ORDER ITEM
// ============================================================

model OrderItem {
  id        Int @id @default(autoincrement())
  orderId   Int
  productId Int

  /*
   * Exact ProductVariant ID.
   * Nullable so products without Variants
   * remain supported.
   */

  variantId Int?

  brand       String
  productName String
  sku         String?
  color       String?
  variant     String?
  dimensions  String?
  packaging   String?
  quantity    Int      @default(1)
  unitPrice   Float
  totalPrice  Float

  /*
   * Cost / Profit Snapshot
   *
   * These values are stored permanently on the
   * OrderItem so historical orders remain accurate
   * even if the Product / ProductVariant cost price
   * or exchange rate changes later.
   *
   * unitCost:
   * Cost of one unit in MYR.
   *
   * totalCost:
   * unitCost × quantity.
   *
   * profit:
   * totalPrice - totalCost.
   *
   * Nullable for legacy orders or products where
   * a valid cost price cannot be determined.
   */

  unitCost  Float?
  totalCost Float?
  profit    Float?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  order   Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id])

  /*
   * IMPORTANT:
   *
   * Do NOT name this relation "variant"
   * because "variant" is already the String field
   * that stores the selected Size / Variant display value.
   */

  productVariant ProductVariant? @relation(fields: [variantId], references: [id])

  @@index([orderId])
  @@index([productId])
  @@index([variantId])
}


// ============================================================
// PAYMENT
// ============================================================

model Payment {
  id              Int  @id @default(autoincrement())
  orderId         Int  @unique
  paymentMethodId Int?

  /*
   * Snapshot of the selected payment method.
   * Existing orders keep the original payment information
   * even if the Payment Method is changed later.
   */

  paymentMethodName String
  paymentMethodType PaymentMethodType
  bankName          String?
  accountName       String?
  accountNumber     String?
  qrImageUrl        String?
  qrPublicId        String?
  amount            Float
  status            PaymentStatus     @default(PENDING)
  proofUrl          String?
  proofPublicId     String?
  verifiedAt        DateTime?
  verifiedBy        Int?
  adminNote         String?
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt

  order         Order          @relation(fields: [orderId], references: [id], onDelete: Cascade)
  paymentMethod PaymentMethod? @relation(fields: [paymentMethodId], references: [id])

  @@index([paymentMethodId])
  @@index([status])
  @@index([createdAt])
}


// ============================================================
// VOUCHER
// ============================================================

model Voucher {
  id Int @id @default(autoincrement())

  /*
   * Voucher code shown to customers.
   * Stored uppercase so validation remains consistent.
   */

  code String @unique

  /*
   * FIXED:
   * RM100 OFF
   *
   * PERCENTAGE:
   * 10% OFF
   */

  type VoucherType

  /*
   * Discount value.
   *
   * FIXED:
   * 100 = RM100
   *
   * PERCENTAGE:
   * 10 = 10%
   */

  value Float

  /*
   * Minimum product subtotal required
   * before the voucher can be used.
   */

  minSpend Float @default(0)

  /*
   * Maximum discount allowed.
   * Mainly useful for percentage vouchers.
   *
   * Example:
   * 10% OFF
   * Maximum RM300
   */

  maxDiscount Float?

  /*
   * Optional category restriction.
   *
   * NULL:
   * All categories
   *
   * "Bags":
   * Bags only
   *
   * "Watches":
   * Watches only
   */

  category String?

  /*
   * Voucher validity period.
   */

  startAt   DateTime @default(now())
  expiresAt DateTime?

  /*
   * Total number of times this voucher
   * can be redeemed.
   *
   * NULL = unlimited.
   */

  usageLimit Int?

  /*
   * Number of successful redemptions.
   */

  usageCount Int @default(0)

  /*
   * Maximum number of times one customer
   * can use this voucher.
   *
   * NULL = unlimited.
   */

  usagePerCustomer Int?

  /*
   * Only customers who have never
   * successfully placed an order
   * can use this voucher.
   */

  newCustomerOnly Boolean @default(false)

  /*
   * Admin can activate/deactivate
   * the voucher without deleting it.
   */

  isActive Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  usage VoucherUsage[]

  @@index([code])
  @@index([isActive])
  @@index([startAt])
  @@index([expiresAt])
  @@index([category])
}


// ============================================================
// VOUCHER USAGE
// ============================================================

model VoucherUsage {
  id Int @id @default(autoincrement())

  voucherId Int
  orderId   Int

  /*
   * Nullable because orders can exist
   * without a logged-in Customer Account.
   */

  userId Int?

  /*
   * Actual discount granted by this
   * particular Voucher usage.
   *
   * This is stored permanently so changing
   * the Voucher later does not alter
   * historical order records.
   */

  discount Float

  createdAt DateTime @default(now())

  voucher Voucher @relation(fields: [voucherId], references: [id], onDelete: Restrict)
  order   Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  user    User?   @relation(fields: [userId], references: [id], onDelete: SetNull)

  /*
   * One Voucher can only be attached
   * once to one Order.
   */

  @@unique([orderId])
  @@index([voucherId])
  @@index([userId])
  @@index([createdAt])
}


// ============================================================
// SETTING
// ============================================================

model Setting {
  id                 Int      @id @default(autoincrement())
  companyName        String   @default("COMBINE")
  whatsappNumber     String   @default("60166620448")
  exchangeRate       Float    @default(0.59)
  email              String?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
  address            String?
  companyDescription String?
  companyLogo        String?
  facebook           String?
  instagram          String?
  maintenanceMode    Boolean  @default(false)
  metaDescription    String?
  phone              String?
  siteTitle          String?
  tiktok             String?
  website            String?
  youtube            String?
}


// ============================================================
// ANALYTICS VISITOR
// ============================================================

model AnalyticsVisitor {
  id          Int      @id @default(autoincrement())
  visitorId   String   @unique
  firstSeenAt DateTime @default(now())
  lastSeenAt  DateTime @updatedAt

  @@index([firstSeenAt])
  @@index([lastSeenAt])
}


// ============================================================
// ANALYTICS EVENT
// ============================================================

model AnalyticsEvent {
  id        Int                @id @default(autoincrement())
  visitorId String
  event     AnalyticsEventType
  path      String?
  productId Int?
  createdAt DateTime           @default(now())

  @@index([visitorId])
  @@index([event])
  @@index([createdAt])
  @@index([productId])
}


// ============================================================
// ENUMS
// ============================================================

enum PaymentMethodType {
  BANK_TRANSFER
  QR
}


enum OrderStatus {
  PENDING_PAYMENT
  PAYMENT_REVIEW
  PAID
  PROCESSING
  SHIPPED
  COMPLETED
  CANCELLED
}


enum PaymentStatus {
  PENDING
  SUBMITTED
  VERIFIED
  REJECTED
}


enum Availability {
  IN_STOCK
  PRE_ORDER
  LIMITED
  SOLD_OUT
}


enum ImageType {
  MAIN
  GALLERY
  DETAIL
  PACKAGING
}


enum UserRole {
  CUSTOMER
  ADMIN
  STAFF
  MANAGER
  OWNER
}


enum InquiryStatus {
  PENDING
  CONTACTED
  COMPLETED
  CANCELLED
}


// ============================================================
// VOUCHER TYPE
// ============================================================

enum VoucherType {
  FIXED
  PERCENTAGE
}


enum AnalyticsEventType {
  PAGE_VIEW
  PRODUCT_VIEW
  WHATSAPP_CLICK
  INSTAGRAM_CLICK
}